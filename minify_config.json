{
    "entries": [
        "static/deps/**/*.js"
    ],
    "output_dir": "static/collected",
    "options": {
        "minify": true,
        "compress": {
            "arguments": true,
            "arrows": true,
            "booleans": true,
            "booleans_as_integers": true,
            "collapse_vars": true,
            "comparisons": true,
            "conditionals": true,
            "dead_code": true,
            "drop_console": true,
            "drop_debugger": true,
            "evaluate": true,
            "expression": false,
            "hoist_funs": true,
            "hoist_props": true,
            "hoist_vars": true,
            "if_return": true,
            "inline": 3,
            "join_vars": true,
            "keep_classnames": false,
            "keep_fargs": false,
            "keep_fnames": false,
            "keep_infinity": true,
            "loops": true,
            "negate_iife": true,
            "passes": 10,
            "properties": true,
            "pure_funcs": [
                "console.log",
                "console.info",
                "console.warn",
                "console.error",
                "console.debug",
                "console.trace",
                "alert"
            ],
            "pure_getters": "strict",
            "reduce_funcs": true,
            "reduce_vars": true,
            "sequences": true,
            "side_effects": true,
            "switches": true,
            "toplevel": true,
            "typeofs": true,
            "unsafe": true,
            "unsafe_arrows": true,
            "unsafe_comps": true,
            "unsafe_math": true,
            "unsafe_methods": true,
            "unsafe_proto": true,
            "unsafe_regexp": true,
            "unsafe_undefined": true,
            "unused": true
        },
        "mangle": {
            "toplevel": true,
            "keep_classnames": false,
            "keep_fnames": false,
            "keep_private_props": false,
            "ie8": false,
            "safari10": false
        },
        "output": {
            "ascii_only": true,
            "beautify": false,
            "comments": false,
            "indent_level": 0,
            "indent_start": 0,
            "inline_script": true,
            "keep_numbers": false,
            "keep_quoted_props": false,
            "max_line_len": false,
            "preamble": "",
            "preserve_line": false,
            "quote_keys": false,
            "quote_style": 0,
            "safari10": false,
            "semicolons": true,
            "shebang": false,
            "wrap_iife": false,
            "wrap_func_args": false,
            "ecma": 2020,
            "webkit": false
        },
        "remove_comments": true,
        "source_maps": false
    }
}